# Moodlelike standalone environment template. CSCA/CSCALITE prefixes remain compatibility contracts until a versioned rename.
# Moodlelike production environment template.
# Copy these names into your production secret manager or deployment environment.
# Do not commit real production values.

NODE_ENV="production"
MOODLELIKE_ENV="production"
# CSC_ENV remains accepted as a deprecated fallback when MOODLELIKE_ENV is absent.

# PostgreSQL connection used by Prisma. Required.
# Use TLS for remote production PostgreSQL unless your provider documents an equivalent private trusted connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/moodlelike?schema=public&sslmode=require"

# Preferred V1 auth signing secret. Required. Use a long random value.
AUTH_SECRET="REPLACE_WITH_PRODUCTION_AUTH_SECRET"

# Compatibility only. Prefer AUTH_SECRET for new deployments.
JWT_SECRET="REPLACE_WITH_PRODUCTION_AUTH_SECRET"

# Refresh sessions are returned as JSON for compatibility and as HttpOnly cookies when enabled.
AUTH_REFRESH_COOKIE_ENABLED="true"
AUTH_REFRESH_COOKIE_NAME="moodlelike_refresh"
AUTH_CSRF_COOKIE_NAME="moodlelike_csrf"
AUTH_CSRF_HEADER_NAME="x-csrf-token"
AUTH_LEGACY_REFRESH_FALLBACK_ENABLED="false"
AUTH_COOKIE_DOMAIN=""
AUTH_COOKIE_SECURE="true"
VITE_AUTH_CSRF_COOKIE_NAME="moodlelike_csrf"
VITE_AUTH_CSRF_HEADER_NAME="X-CSRF-Token"

# Optional Google OAuth login. Configure the same redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://www.example.com/api/v1/auth/google/callback"
AUTH_GOOGLE_STATE_COOKIE_NAME="moodlelike_oauth_state"

# First admin bootstrap account. Required only for first admin bootstrap.
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_ONE_TIME_ADMIN_BOOTSTRAP_PASSWORD"

# V1 simulated payment callback HMAC secret. Required only when simulated payment endpoints are enabled.
PAYMENT_CALLBACK_SECRET="REPLACE_WITH_PRODUCTION_PAYMENT_CALLBACK_SECRET"

# Gumroad hosted checkout. Webhooks must point to:
# https://www.example.com/api/v1/commerce/payments/gumroad/callback
GUMROAD_PRODUCT_URL="https://your-name.gumroad.com/l/your-product"
GUMROAD_ACCESS_TOKEN="REPLACE_WITH_GUMROAD_API_TOKEN"

# DeepSeek First AI Gateway. Do not expose provider keys to the frontend.
# Dedicated pools keep platform background generation, organization BYOK, and personal users isolated.
# `DEEPSEEK_API_KEYS` is kept only as a legacy compatibility pool; production should prefer the scoped pools below.
AI_GATEWAY_ENABLED="true"
AI_DEFAULT_PROVIDER="deepseek"
AI_GATEWAY_LEDGER_ENABLED="true"
AI_GATEWAY_GLOBAL_CONCURRENCY="5"
AI_GATEWAY_REALTIME_CONCURRENCY="3"
AI_GATEWAY_BACKGROUND_CONCURRENCY="2"
SUBJECT_PRACTICE_OBSERVATION_TASK_ENABLED="false"
SUBJECT_PRACTICE_OBSERVATION_EXECUTION_ENABLED="false"
SUBJECT_PRACTICE_OBSERVATION_SINGLETON_CONFIRMED="false"
SUBJECT_PRACTICE_OBSERVATION_ONLY_MODE="false"
CSCA_SUBJECT_PRACTICE_LOCAL_GENERATOR_SHADOW_ENABLED="false"
AI_GATEWAY_DEFAULT_TIMEOUT_MS="30000"
AI_GATEWAY_STUDENT_TIMEOUT_MS="15000"
AI_GATEWAY_BACKGROUND_TIMEOUT_MS="60000"
AI_GATEWAY_QUEUE_TIMEOUT_MS="5000"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_API_KEYS=""
DEEPSEEK_BACKGROUND_API_KEYS="REPLACE_WITH_BACKGROUND_DEEPSEEK_KEY_POOL"
DEEPSEEK_PERSONAL_API_KEYS="REPLACE_WITH_PERSONAL_DEEPSEEK_KEY_POOL"
DEEPSEEK_BACKGROUND_BASE_URL="https://api.deepseek.com"
DEEPSEEK_PERSONAL_BASE_URL="https://api.deepseek.com"
DEEPSEEK_DEFAULT_MODEL="deepseek-v4-flash"
DEEPSEEK_BACKGROUND_DEFAULT_MODEL="deepseek-v4-flash"
DEEPSEEK_PERSONAL_DEFAULT_MODEL="deepseek-v4-flash"
DEEPSEEK_PRO_MODEL="deepseek-v4-pro"
DEEPSEEK_REASONER_MODEL="deepseek-v4-pro"
DEEPSEEK_KEY_CONCURRENCY="2"
DEEPSEEK_BACKGROUND_KEY_CONCURRENCY="2"
DEEPSEEK_PERSONAL_KEY_CONCURRENCY="2"
DEEPSEEK_REQUESTS_PER_MINUTE="60"
DEEPSEEK_BACKGROUND_REQUESTS_PER_MINUTE="60"
DEEPSEEK_PERSONAL_REQUESTS_PER_MINUTE="60"
DEEPSEEK_REQUESTS_PER_DAY="5000"
DEEPSEEK_BACKGROUND_REQUESTS_PER_DAY="5000"
DEEPSEEK_PERSONAL_REQUESTS_PER_DAY="5000"
AI_GATEWAY_COST_CURRENCY="USD"
AI_GATEWAY_DISPLAY_CURRENCY="CNY"
AI_GATEWAY_USD_CNY_RATE="7.25"
DEEPSEEK_V4_FLASH_INPUT_COST_PER_1M_TOKENS="0.44"
DEEPSEEK_V4_FLASH_OUTPUT_COST_PER_1M_TOKENS="1.32"
DEEPSEEK_V4_PRO_INPUT_COST_PER_1M_TOKENS="1.32"
DEEPSEEK_V4_PRO_OUTPUT_COST_PER_1M_TOKENS="3.96"
DEEPSEEK_CHAT_INPUT_COST_PER_1M_TOKENS="0.27"
DEEPSEEK_CHAT_OUTPUT_COST_PER_1M_TOKENS="1.10"
DEEPSEEK_REASONER_INPUT_COST_PER_1M_TOKENS="0.55"
DEEPSEEK_REASONER_OUTPUT_COST_PER_1M_TOKENS="2.19"

# Optional AI Coach provider. Keep rollout at 0 until readiness smoke passes.
# Legacy CSCA_AI_* provider settings remain accepted by the Gateway for compatibility.
# Do not expose CSCA_AI_API_KEY to the frontend.
CSCA_AI_COACH_ENABLED="false"
CSCA_AI_PROVIDER="rule-fallback"
CSCA_AI_MODEL=""
CSCA_AI_API_KEY=""
CSCA_AI_BASE_URL="https://api.openai.com/v1"
CSCA_AI_TIMEOUT_MS="8000"
CSCA_AI_TEMPERATURE="0.2"
CSCA_AI_PROMPT_VERSION="coach-v2-safety"
CSCA_AI_MAX_OUTPUT_CHARS="1200"
CSCA_AI_ROLLOUT_PERCENT="0"
CSCA_AI_INITIAL_FREE_UNITS="50"
CSCA_AI_ENTITLEMENT_ENABLED="false"
CSCA_AI_INPUT_COST_PER_1K_TOKENS="0.00014"
CSCA_AI_OUTPUT_COST_PER_1K_TOKENS="0.00028"
CSCA_AI_UNIT_TOKEN_BUDGET="2000"
CSCA_AI_COST_CURRENCY="USD"
CSCA_AI_ROLLOUT_MIN_INTERACTIONS="20"
CSCA_AI_ROLLOUT_MIN_FEEDBACK="5"
CSCA_AI_ROLLOUT_MAX_ERROR_RATE="0.05"
CSCA_AI_ROLLOUT_MAX_REJECTION_RATE="0.02"
CSCA_AI_ROLLOUT_MAX_LOW_FEEDBACK_RATE="0.2"
CSCA_AI_ROLLOUT_MIN_AVERAGE_RATING="3.5"
# Optional structured LLM assistance for adaptive round planning.
# Keep false until the AI Coach provider rollout is healthy; Rule Guard remains final even when enabled.
CSCA_PLANNER_ASSISTANT_AI_ENABLED="false"
# Dedicated encryption secret for organization BYOK provider keys.
# Prefer a separate long random value so BYOK secrets can rotate independently from auth signing keys.
CSCA_ORG_LLM_KEY_SECRET="REPLACE_WITH_PRODUCTION_ORG_LLM_KEY_SECRET"

# Platform-side AI question review. This is separate from student-facing AI Coach usage.
# If unset, the reviewer can reuse CSCA_AI_PROVIDER / CSCA_AI_MODEL / CSCA_AI_API_KEY.
CSCA_AI_QUESTION_REVIEW_ENABLED="false"
CSCA_AI_QUESTION_REVIEW_PROVIDER="deepseek"
CSCA_AI_QUESTION_REVIEW_MODEL="deepseek-v4-flash"
CSCA_AI_QUESTION_REVIEW_API_KEY=""
CSCA_AI_QUESTION_REVIEW_BASE_URL="https://api.deepseek.com"
CSCA_AI_QUESTION_REVIEW_TIMEOUT_MS="10000"
CSCA_AI_QUESTION_REVIEW_TEMPERATURE="0.1"
CSCA_AI_QUESTION_BLIND_REVIEW_ENABLED="false"
CSCA_AI_QUESTION_BLIND_REVIEW_MODEL=""
CSCA_AI_QUESTION_BLIND_REVIEW_PROMPT_VERSION="blind-answer-review-v1"

# Platform-side AI question generation. If unset, it can reuse CSCA_AI_PROVIDER / CSCA_AI_MODEL / CSCA_AI_API_KEY.
CSCA_AI_QUESTION_GENERATION_ENABLED="false"
CSCA_AI_QUESTION_GENERATION_PROVIDER="deepseek"
CSCA_AI_QUESTION_GENERATION_MODEL="deepseek-v4-flash"
CSCA_AI_QUESTION_GENERATION_PRO_MODEL="deepseek-v4-pro"
CSCA_AI_QUESTION_GENERATION_API_KEY=""
CSCA_AI_QUESTION_GENERATION_BASE_URL="https://api.deepseek.com"
CSCA_AI_QUESTION_GENERATION_TIMEOUT_MS="90000"
CSCA_AI_QUESTION_GENERATION_MAX_TOKENS="8000"
CSCA_AI_QUESTION_GENERATION_PRO_TIMEOUT_MS="180000"
CSCA_AI_QUESTION_GENERATION_PRO_MAX_TOKENS="16000"

# Student-facing special practice sessions. Set to "false" to keep topic banks visible but stop students from starting immature pools.
CSCALITE_SPECIAL_PRACTICE_STUDENT_SESSIONS_ENABLED="true"
CSCA_AI_QUESTION_GENERATION_TEMPERATURE="0.35"
# Online mock exam AI generation runs a bounded slot worker pool. Range: 1-5, default: 3.
CSCA_MOCK_EXAM_AI_GENERATION_CONCURRENCY="3"

# Optional platform-side AI question production scheduler. Keep disabled until provider, review, and admin queues are staffed.
CSCA_AI_QUESTIONING_SCHEDULER_ENABLED="false"
CSCA_AI_QUESTIONING_SCHEDULER_RUN_ON_STARTUP="false"
CSCA_AI_QUESTIONING_SCHEDULER_INTERVAL_MINUTES="30"
CSCA_AI_QUESTIONING_SCHEDULER_PROCESS_LIMIT="10"
CSCA_AI_QUESTIONING_SCHEDULER_BACKFILL_LIMIT="10"
CSCA_AI_QUESTIONING_SCHEDULER_PER_TOPIC="1"
CSCA_AI_QUESTIONING_SCHEDULER_RETRY_FAILED="false"

# Fixed-question-bank release isolation. Do not change these in the public app deployment until AI production has a separate approved rollout.
CSCA_SUBJECT_PRACTICE_PRODUCTION_ENABLED="false"
CSCA_SUBJECT_PRACTICE_PREDICTIVE_REPLENISHMENT_ENABLED="false"
CSCA_AI_QUESTIONING_TASK_RECOVERY_DISABLED="true"
CSCA_SUBJECT_PRACTICE_LIFECYCLE_RECONCILIATION_DISABLED="true"

# Verified local deterministic generator limited release. Keep disabled until exact-family shadow evidence qualifies.
CSCA_SUBJECT_PRACTICE_LIMITED_RELEASE_ENABLED="false"
CSCA_SUBJECT_PRACTICE_LIMITED_RELEASE_EXACT_PLAN_ALLOWLIST=""
CSCA_SUBJECT_PRACTICE_LIMITED_RELEASE_QUALIFIED_EXACT_PLANS=""
CSCA_SUBJECT_PRACTICE_LIMITED_RELEASE_MAX_APPROVALS_PER_HOUR="3"
CSCA_SUBJECT_PRACTICE_LIMITED_RELEASE_MAX_APPROVALS_PER_DAY="12"
CSCA_SUBJECT_PRACTICE_LIMITED_RELEASE_QUALITY_WINDOW_SIZE="20"
CSCA_SUBJECT_PRACTICE_LIMITED_RELEASE_MINIMUM_QUALITY_SAMPLE_SIZE="8"
CSCA_SUBJECT_PRACTICE_LIMITED_RELEASE_MINIMUM_PUBLISHABLE_RATE="0.95"
CSCA_SUBJECT_PRACTICE_LIMITED_RELEASE_MAXIMUM_CONSECUTIVE_FAILURES="2"

# Machine attestation for read-only production-shadow evidence exports (minimum 32 characters).
CSCA_PRODUCTION_SHADOW_EXPORTER_HMAC_SECRET=""

# Comma-separated browser origins allowed to call the API. Required.
CORS_ORIGINS="https://app.moodlelike.example"

# Public browser origin used for CSP and deployment smoke.
PUBLIC_APP_ORIGIN="https://app.moodlelike.example"
PUBLIC_API_ORIGIN="https://api.moodlelike.example"

# SMTP email delivery for account verification and password reset.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SECURE="true"
CONSULTING_INQUIRY_TO="support@moodlelike.example"
CONSULTING_IP_RATE_LIMIT="3"
CONSULTING_IP_RATE_WINDOW_MS="600000"
CONSULTING_EMAIL_RATE_LIMIT="3"
CONSULTING_EMAIL_RATE_WINDOW_MS="1800000"

# Staging verification target. Keep production and staging values separate.
STAGING_BASE_URL="https://staging.example.com"

# Local Docker release rehearsal defaults. Keep these local-only.
LOCAL_STAGING_BASE_URL="http://127.0.0.1:18080"
DOCKER_COMPOSE_PROJECT="moodlelike-verify"
DOCKER_BACKUP_CONTAINER="moodlelike-verify-db-1"

# Structured logs are recommended in production.
REQUEST_BODY_LIMIT="128kb"
READY_DB_TIMEOUT_MS="1500"
LOG_FORMAT="json"

# Start staging with report-only. Switch to enforce only after CSP reports are clean.
CSP_MODE="report-only"
CSP_REPORT_URI="/api/v1/ops/csp-report"

# Optional lightweight metrics endpoint. Protect with OPS_METRICS_TOKEN if enabled.
OPS_METRICS_ENABLED="false"
OPS_METRICS_TOKEN="REPLACE_WITH_OPTIONAL_METRICS_TOKEN"

# Optional readiness protection. If set, /api/v1/ops/ready requires Authorization: Bearer <token>.
OPS_READY_TOKEN=""

# Production health is minimal by default. Enable only for private trusted health checks.
OPS_HEALTH_DETAILS_ENABLED="false"

# Scheduled refresh for readiness recommendation calibration snapshots.
# Enable after the readiness calibration snapshot migration has been applied.
# Runs in Asia/Shanghai time.
CSCA_READINESS_CALIBRATION_SCHEDULE_ENABLED="false"
CSCA_READINESS_CALIBRATION_SCHEDULE_HOUR="3"
CSCA_READINESS_CALIBRATION_SCHEDULE_MINUTE="20"
CSCA_READINESS_CALIBRATION_SCHEDULE_RUN_ON_STARTUP="false"

# Readiness high-difficulty evidence thresholds.
# Keep static until Admin Audit distributions look stable; then sampled can adopt recent production recommendations.
CSCA_READINESS_HIGH_DIFFICULTY_THRESHOLD_MODE="static"
CSCA_READINESS_HIGH_DIFFICULTY_REQUIRED_MATH=""
CSCA_READINESS_HIGH_DIFFICULTY_REQUIRED_PHYSICS=""
CSCA_READINESS_HIGH_DIFFICULTY_REQUIRED_CHEMISTRY=""
CSCA_READINESS_SAMPLED_THRESHOLD_MAX_IMPACT_USER_SUBJECTS="5"

APP_VERSION="REPLACE_WITH_RELEASE_VERSION"

# Release smoke evidence is written locally by verification scripts and must not be committed.
RELEASE_EVIDENCE_DIR=".tmp/release-evidence"

# Local backup directory on the runner/host. Keep this outside any public web root.
BACKUP_DIR=".tmp/backups"
DOCKER_BACKUP_OUTPUT_FILE=""

# Set only for a deliberate restore command, never as a permanent production secret.
ALLOW_DB_RESTORE="0"

# Emergency production restore requires both of these in addition to ALLOW_DB_RESTORE=1.
# Do not keep them set permanently.
ALLOW_PRODUCTION_DB_RESTORE="0"
CONFIRM_RESTORE_DATABASE=""

# Restore smoke must point to a non-production database, never the production DATABASE_URL.
RESTORE_TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/moodlelike_restore_test?schema=public&sslmode=require"
BACKUP_RESTORE_DRILL_FILE=".tmp/backups/REPLACE_WITH_REAL_BACKUP.dump"

# Shared rate limiting for multi-instance backend deployments.
# Use memory only for local development or a deliberate single-instance production launch.
RATE_LIMIT_STORE="redis"
RATE_LIMIT_REDIS_URL="redis://HOST:6379"
RATE_LIMIT_REDIS_TIMEOUT_MS="500"

# Optional cache URL for future shared-cache phases. RATE_LIMIT_REDIS_URL takes precedence for auth rate limits.
REDIS_URL="redis://HOST:6379"

# Security cleanup retention windows. `npm run db:cleanup-security` is dry-run by default.
CLEANUP_AUTH_EMAIL_TOKEN_DAYS="7"
CLEANUP_REFRESH_SESSION_DAYS="30"
CLEANUP_PAYMENT_CALLBACK_LOG_DAYS="90"

# Source-corpus evidence signing. Provision distinct secrets through the deployment secret manager.
CSCA_SOURCE_CORPUS_SCANNER_HMAC_SECRET=""
CSCA_SOURCE_CORPUS_SCANNER_ID=""
CSCA_SOURCE_CORPUS_SCANNER_KEY_ID=""

# Topology attestations require a separate >=32-character secret and comma-separated allowlists.
CSCA_SOURCE_CORPUS_TOPOLOGY_HMAC_SECRET=""
CSCA_SOURCE_CORPUS_TOPOLOGY_ALLOWED_REVIEWER_IDS=""
CSCA_SOURCE_CORPUS_TOPOLOGY_ALLOWED_KEY_IDS=""
CSCA_SOURCE_CORPUS_TRANSLATION_REVIEW_HMAC_SECRET=""
CSCA_SOURCE_CORPUS_TRANSLATION_REVIEWER_IDS=""
CSCA_SOURCE_CORPUS_TRANSLATION_REVIEW_KEY_IDS=""
CSCA_AGENT_TEACHING_ASSET_ROUTING_MODE="legacy"
CSCA_AGENT_TEACHING_ASSET_ROUTING_ACTIVE_SUBJECTS=""
CSCA_AGENT_TEACHING_ASSET_ROUTING_ACTIVE_PERCENT="0"
