  evidenceCandidates AgentAttachmentEvidenceCandidate[]
  questionMatches    AgentAttachmentQuestionMatch[]

  @@unique([attachmentId, clientRequestId], map: "uq_agent_attachment_analysis_request")
  @@index([userId, status, createdAt], map: "idx_agent_attachment_analyses_user_status")
  @@index([conversationId, createdAt], map: "idx_agent_attachment_analyses_conversation")
  @@map("agent_attachment_analyses")
}

model AgentAttachmentAnalysisItem {
  id             String   @id @default(cuid())
  analysisId     String   @map("analysis_id")
  userId         Int      @map("user_id")
  ordinal        Int
  subjectCode    String?  @map("subject_code") @db.VarChar(24)
  questionNumber String?  @map("question_number") @db.VarChar(80)
  questionText   String   @map("question_text") @db.Text
  studentAnswer  String?  @map("student_answer") @db.VarChar(500)
  assessment     String   @db.VarChar(32)
  errors         Json     @default("[]")
  guidance       Json     @default("[]")
  pageNumber     Int?     @map("page_number")
  region         Json?
  citations      Json     @default("[]")
  uncertainty    String?  @db.VarChar(600)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  analysis          AgentAttachmentAnalysis           @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user              User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionMatch     AgentAttachmentQuestionMatch?
  evidenceCandidate AgentAttachmentEvidenceCandidate?

  @@unique([analysisId, ordinal], map: "uq_agent_attachment_analysis_items_ordinal")
  @@index([userId, createdAt], map: "idx_agent_attachment_analysis_items_user")
  @@map("agent_attachment_analysis_items")
}

model AgentAttachmentQuestionMatch {
  id                  String   @id @default(cuid())
  userId              Int      @map("user_id")
  analysisId          String   @map("analysis_id")
  analysisItemId      String?  @unique @map("analysis_item_id")
  status              String   @db.VarChar(32)
  sourceType          String?  @map("source_type") @db.VarChar(48)
  sourceId            String?  @map("source_id") @db.VarChar(120)
  sourceVersion       Int?     @map("source_version")
  sourceTitle         String?  @map("source_title") @db.VarChar(240)
  subjectCode         String?  @map("subject_code") @db.VarChar(24)
  topicId             Int?     @map("topic_id")
  promptScore         Float    @default(0) @map("prompt_score")
  runnerUpScore       Float    @default(0) @map("runner_up_score")
  extractedPromptHash String?  @map("extracted_prompt_hash") @db.VarChar(64)
  extractedAnswer     String?  @map("extracted_answer") @db.VarChar(120)
  correctAnswerHash   String?  @map("correct_answer_hash") @db.VarChar(64)
  verifiedOutcome     String?  @map("verified_outcome") @db.VarChar(24)
  matcherVersion      String   @map("matcher_version") @db.VarChar(64)
  matchSnapshot       Json     @default("{}") @map("match_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis     AgentAttachmentAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  analysisItem AgentAttachmentAnalysisItem? @relation(fields: [analysisItemId], references: [id], onDelete: Cascade)

  @@index([analysisId], map: "idx_agent_attachment_question_matches_analysis")
  @@index([userId, status, createdAt], map: "idx_agent_attachment_question_matches_user_status")
  @@index([sourceType, sourceId], map: "idx_agent_attachment_question_matches_source")
  @@map("agent_attachment_question_matches")
}

model AgentAttachmentEvidenceCandidate {
  id               String    @id @default(cuid())
  userId           Int       @map("user_id")
  conversationId   String    @map("conversation_id")
  analysisId       String    @map("analysis_id")
  analysisItemId   String?   @unique @map("analysis_item_id")
  attachmentId     String    @map("attachment_id")
  status           String    @default("pending_confirmation") @db.VarChar(32)
  subjectCode      String?   @map("subject_code") @db.VarChar(24)
  suggestedTopicId Int?      @map("suggested_topic_id")
  confirmedTopicId Int?      @map("confirmed_topic_id")
  outcome          String?   @db.VarChar(24)
  confidence       Float     @default(0)
  gateReasons      Json      @default("[]") @map("gate_reasons")
  sourceSnapshot   Json      @map("source_snapshot")
  evidenceId       String?   @unique @map("evidence_id")
  decisionBefore   Json?     @map("decision_before")
  decisionAfter    Json?     @map("decision_after")
  confirmedAt      DateTime? @map("confirmed_at")
  rejectedAt       DateTime? @map("rejected_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AgentConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  analysis     AgentAttachmentAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  analysisItem AgentAttachmentAnalysisItem? @relation(fields: [analysisItemId], references: [id], onDelete: Cascade)
  attachment   AgentAttachment              @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  evidence     LearningEvidenceEvent?       @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt], map: "idx_agent_attachment_evidence_candidates_user_status")
  @@index([conversationId, createdAt], map: "idx_agent_attachment_evidence_candidates_conversation")
  @@index([analysisId], map: "idx_agent_attachment_evidence_candidates_analysis")
  @@map("agent_attachment_evidence_candidates")
}

model AgentRun {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  userId         Int       @map("user_id")
  status         String    @default("queued") @db.VarChar(24)
  channel        String    @default("web") @db.VarChar(24)
  traceId        String    @unique @map("trace_id") @db.VarChar(80)
  inputSnapshot  Json?     @map("input_snapshot")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  leaseUntil     DateTime? @map("lease_until")
  attemptCount   Int       @default(0) @map("attempt_count")
  errorCode      String?   @map("error_code") @db.VarChar(80)
  errorRetryable Boolean?  @map("error_retryable")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCalls    AgentToolCall[]
  artifacts    AgentArtifact[]
  outbox       AgentOutbox[]

  @@index([conversationId, createdAt], map: "idx_agent_runs_conversation_created")
  @@index([userId, status, createdAt], map: "idx_agent_runs_user_status_created")
  @@index([status, leaseUntil], map: "idx_agent_runs_status_lease")
  @@map("agent_runs")
}

model AgentToolCall {
  id                 String    @id @default(cuid())
  runId              String    @map("run_id")
  userId             Int       @map("user_id")
  toolName           String    @map("tool_name") @db.VarChar(100)
  toolVersion        String    @map("tool_version") @db.VarChar(24)
  status             String    @default("pending") @db.VarChar(24)
  idempotencyKeyHash String?   @map("idempotency_key_hash") @db.VarChar(128)
  input              Json
  output             Json?
  errorCode          String?   @map("error_code") @db.VarChar(80)
  createdAt          DateTime  @default(now()) @map("created_at")
  completedAt        DateTime? @map("completed_at")

  run  AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolName, toolVersion, idempotencyKeyHash], map: "uq_agent_tool_calls_idempotency")
  @@index([runId, createdAt], map: "idx_agent_tool_calls_run_created")
  @@map("agent_tool_calls")
}

model AgentArtifact {
  id               String   @id @default(cuid())
  conversationId   String   @map("conversation_id")
  runId            String   @map("run_id")
  userId           Int      @map("user_id")
  type             String   @db.VarChar(60)
  version          Int      @default(1)
  status           String   @default("ready") @db.VarChar(24)
  title            String   @db.VarChar(200)
  summary          String?  @db.Text
  domainEntityType String?  @map("domain_entity_type") @db.VarChar(60)
  domainEntityId   String?  @map("domain_entity_id") @db.VarChar(120)
  route            String?  @db.VarChar(500)
  snapshot         Json?
  createdAt        DateTime @default(now()) @map("created_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run          AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, type, version], map: "uq_agent_artifacts_run_type_version")
  @@index([userId, type, createdAt], map: "idx_agent_artifacts_user_type_created")
  @@index([domainEntityType, domainEntityId], map: "idx_agent_artifacts_domain_entity")
  @@map("agent_artifacts")
}

model AgentOutbox {
  id             String    @id @default(cuid())
  conversationId String?   @map("conversation_id")
  runId          String?   @map("run_id")
  eventType      String    @map("event_type") @db.VarChar(80)
  sequence       Int?
  eventKey       String?   @map("event_key") @db.VarChar(120)
  payload        Json
  status         String    @default("pending") @db.VarChar(24)
  attemptCount   Int       @default(0) @map("attempt_count")
  availableAt    DateTime  @default(now()) @map("available_at")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run          AgentRun?          @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence], map: "uq_agent_outbox_run_sequence")
  @@unique([runId, eventKey], map: "uq_agent_outbox_run_event_key")
  @@index([status, availableAt], map: "idx_agent_outbox_status_available")
  @@index([runId, createdAt], map: "idx_agent_outbox_run_created")
  @@map("agent_outbox")
}
