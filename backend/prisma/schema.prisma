generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  advisor
  admin
}

enum UserStatus {
  active
  disabled
}

enum SchoolType {
  regular
  partner
}

enum SchoolStatus {
  draft
  published
  archived
}

enum CartItemType {
  SCHOOL_SERVICE
  ADVISOR_PACKAGE
  AI_CREDITS
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id                      Int        @id @default(autoincrement())
  loginName               String?    @unique @map("login_name") @db.VarChar(50)
  email                   String?    @unique @db.VarChar(255)
  passwordHash            String?    @map("password_hash") @db.VarChar(255)
  role                    UserRole   @default(student)
  status                  UserStatus @default(active)
  displayName             String?    @map("display_name") @db.VarChar(100)
  emailVerifiedAt         DateTime?  @map("email_verified_at")
  emailVerificationSentAt DateTime?  @map("email_verification_sent_at")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  practiceAttempts                         PracticeAttempt[]
  savedSchools                             SavedSchool[]
  compareItems                             SchoolCompareItem[]
  cartItems                                CartItem[]
  orders                                   Order[]
  payments                                 Payment[]
  refreshSessions                          RefreshSession[]
  authEmailTokens                          AuthEmailToken[]
  oauthAccounts                            OAuthAccount[]
  mockExamAttempts                         MockExamAttempt[]
  specialPracticeSessions                  SpecialPracticeSession[]
  pastPaperDownloads                       PastPaperDownload[]
  cscaAIEntitlementAccount                 CscaAIEntitlementAccount?
  cscaAIUsageLedger                        CscaAIUsageLedger[]
  cscaTrainingEvents                       CscaTrainingEvent[]
  cscaLearningDailySnapshots               CscaLearningDailySnapshot[]
  cscaLearningStreak                       CscaLearningStreak?
  cscaLearningInsights                     CscaLearningInsight[]
  cscaWrongPatterns                        CscaWrongPattern[]
  organizationMemberships                  OrganizationMember[]
  organizationInviteAttempts               OrganizationInviteAttempt[]
  studentProfile                           StudentProfile?
  studentScoreGoals                        StudentScoreGoal[]
  studyAvailabilityPreferences             StudyAvailabilityPreference[]
  learningEvidenceEvents                   LearningEvidenceEvent[]
  learningTopicStatesV2                    UserCscaTopicStateV2[]
  learningProjectionCheckpoints            LearningStateProjectionCheckpoint[]
  targetGapSnapshots                       TargetGapSnapshot[]
  learningPrescriptions                    LearningPrescription[]
  learningPrescriptionOutcomes             LearningPrescriptionOutcome[]
  assessmentItemExposures                  AssessmentItemExposure[]
  scoreReadinessForecasts                  ScoreReadinessForecast[]
  scorePredictionShadowRuns                ScorePredictionShadowRun[]
  reviewedExamScoringPolicies              ExamScoringPolicy[]                       @relation("ExamScoringPolicyReviewer")
  createdExamScoringPolicies               ExamScoringPolicy[]                       @relation("ExamScoringPolicyCreator")
  reviewedItemCalibrations                 ItemCalibrationSnapshot[]                 @relation("ItemCalibrationReviewer")
  createdItemCalibrations                  ItemCalibrationSnapshot[]                 @relation("ItemCalibrationCreator")
  reviewedForecastCalibrations             ForecastCalibrationSnapshot[]             @relation("ForecastCalibrationReviewer")
  createdForecastCalibrations              ForecastCalibrationSnapshot[]             @relation("ForecastCalibrationCreator")
  scoreCalibrationGovernanceEvents         ScoreCalibrationGovernanceEvent[]
  learningDecisionCurrents                 LearningDecisionCurrent[]
  learningInterventions                    LearningIntervention[]
  learningInterventionDeliveries           LearningInterventionDelivery[]
  learningInterventionSteps                LearningInterventionStep[]
  learningInterventionVerifications        LearningInterventionVerification[]
  learningInterventionOutcomes             LearningInterventionOutcome[]
  learningInterventionStabilityAssessments LearningInterventionStabilityAssessment[]
  questionSupplyRequestEvents              QuestionSupplyRequestEvent[]
  questionSupplyFulfillmentEvents          QuestionSupplyFulfillmentEvent[]
  agentConversations                       AgentConversation[]
  agentRuns                                AgentRun[]
  agentToolCalls                           AgentToolCall[]
  agentArtifacts                           AgentArtifact[]
  agentAttachments                         AgentAttachment[]
  agentAttachmentAnalyses                  AgentAttachmentAnalysis[]
  agentAttachmentAnalysisItems             AgentAttachmentAnalysisItem[]
  agentAttachmentEvidenceCandidates        AgentAttachmentEvidenceCandidate[]
  agentAttachmentQuestionMatches           AgentAttachmentQuestionMatch[]
  learningEvidenceRetractions              LearningEvidenceRetraction[]
  studentExamOutcomes                      StudentExamOutcome[]                      @relation("StudentExamOutcomeOwner")
  reviewedStudentExamOutcomes              StudentExamOutcome[]                      @relation("StudentExamOutcomeReviewer")
  verifiedStudentExamOutcomes              StudentExamOutcome[]                      @relation("StudentExamOutcomeVerifier")
  studentExamOutcomeEvents                 StudentExamOutcomeEvent[]
  createdForecastDatasetManifests          ForecastCalibrationDatasetManifest[]
  teachingAssetExposures                   TeachingAssetExposure[]
  teachingInteractionEvents                TeachingInteractionEvent[]
  agentPastPaperAttempts                   AgentPastPaperAttempt[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model StudentProfile {
  id                            Int       @id @default(autoincrement())
  userId                        Int       @unique @map("user_id")
  nationality                   String?   @db.VarChar(120)
  nationalityCode               String?   @map("nationality_code") @db.VarChar(2)
  country                       String?   @db.VarChar(120)
  countryCode                   String?   @map("country_code") @db.VarChar(2)
  grade                         String?   @db.VarChar(80)
  gradeCode                     String?   @map("grade_code") @db.VarChar(40)
  genderCode                    String?   @map("gender_code") @db.VarChar(32)
  educationStageCode            String?   @map("education_stage_code") @db.VarChar(40)
  graduationYear                Int?      @map("graduation_year")
  targetExamDate                DateTime? @map("target_exam_date") @db.Date
  targetSubjectCodes            Json?     @map("target_subject_codes")
  preferredQuestionLanguageCode String?   @map("preferred_question_language_code") @db.VarChar(20)
  examAttemptType               String?   @map("exam_attempt_type") @db.VarChar(24)
  weeklyGoalDays                Int?      @map("weekly_goal_days")
  targetMajorCategoryCode       String?   @map("target_major_category_code") @db.VarChar(40)
  onboardingCompletedAt         DateTime? @map("onboarding_completed_at")
  onboardingSkippedAt           DateTime? @map("onboarding_skipped_at")
  currentOrganizationId         Int?      @map("current_organization_id")
  metadata                      Json?
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model AuthEmailToken {
  id        String    @id @default(cuid())
  userId    Int       @map("user_id")
  type      String    @db.VarChar(32)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt], map: "idx_auth_email_tokens_user_type")
  @@index([expiresAt], map: "idx_auth_email_tokens_expires")
  @@map("auth_email_tokens")
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         Int      @map("user_id")
  provider       String   @db.VarChar(32)
  providerUserId String   @map("provider_user_id") @db.VarChar(191)
  email          String?  @db.VarChar(255)
  emailVerified  Boolean  @default(false) @map("email_verified")
  displayName    String?  @map("display_name") @db.VarChar(100)
  pictureUrl     String?  @map("picture_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], map: "uniq_oauth_provider_subject")
  @@index([userId], map: "idx_oauth_accounts_user")
  @@index([email], map: "idx_oauth_accounts_email")
  @@map("oauth_accounts")
}

model RefreshSession {
  id          String    @id @default(cuid())
  userId      Int       @map("user_id")
  sessionHash String    @unique @map("session_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "idx_refresh_sessions_user_revoked")
  @@index([expiresAt], map: "idx_refresh_sessions_expires")
  @@map("refresh_sessions")
}

model PublicContentBlock {
  id        String   @id @default(cuid())
  key       String
  locale    String   @default("zh-CN") @db.VarChar(20)
  title     String
  subtitle  String?
  bodyJson  Json     @map("body_json")
  status    String   @default("published")
  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, locale], map: "uq_content_blocks_key_locale")
  @@index([locale, status, sortOrder], map: "idx_content_blocks_locale_status_sort")
  @@index([status, sortOrder], map: "idx_content_blocks_status_sort")
  @@map("content_blocks")
}

model CityGuide {
  id                           Int          @id @default(autoincrement())
  slug                         String       @unique @db.VarChar(120)
  nameZh                       String       @map("name_zh") @db.VarChar(120)
  nameEn                       String       @map("name_en") @db.VarChar(120)
  region                       String       @db.VarChar(80)
  monthlyCost                  Int?         @map("monthly_cost")
  costLevel                    String?      @map("cost_level") @db.VarChar(40)
  density                      String?      @db.VarChar(40)
  tags                         Json?
  contentJson                  Json         @map("content_json")
  nearby                       Json?
  referenceSchoolCount         Int?         @map("reference_school_count")
  referenceProgramCount        Int?         @map("reference_program_count")
  referenceEnglishProgramCount Int?         @map("reference_english_program_count")
  referenceScholarshipCount    Int?         @map("reference_scholarship_count")
  referenceCscaSchoolCount     Int?         @map("reference_csca_school_count")
  status                       SchoolStatus @default(draft)
  sortOrder                    Int          @default(0) @map("sort_order")
  version                      Int          @default(1)
  createdAt                    DateTime     @default(now()) @map("created_at")
  updatedAt                    DateTime     @updatedAt @map("updated_at")

  @@index([status, sortOrder], map: "idx_city_guides_status_sort")
  @@map("city_guides")
}

model ApplicationTimelineWindow {
  id                Int          @id @default(autoincrement())
  month             String       @db.VarChar(20)
  title             String       @db.VarChar(160)
  applicationWindow String       @map("application_window") @db.VarChar(240)
  cscaWindow        String       @map("csca_window") @db.VarChar(240)
  status            SchoolStatus @default(published)
  sortOrder         Int          @default(0) @map("sort_order")
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([status, sortOrder], map: "idx_application_timeline_windows_status_sort")
  @@map("application_timeline_windows")
}

model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  actorId      Int?     @map("actor_id")
  module       String   @db.VarChar(80)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(120)
  action       String   @db.VarChar(120)
  before       Json?
  after        Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([module, createdAt], map: "idx_admin_audit_logs_module_created")
  @@index([actorId, createdAt], map: "idx_admin_audit_logs_actor_created")
  @@map("admin_audit_logs")
}

model SchoolRaw {
  id          Int       @id @default(autoincrement())
  source      String
  sourceId    String?   @map("source_id")
  payload     Json
  importedAt  DateTime  @default(now()) @map("imported_at")
  processedAt DateTime? @map("processed_at")

  @@index([source, sourceId], map: "idx_schools_raw_source")
  @@map("schools_raw")
}

model School {
  id                   Int        @id @default(autoincrement())
  nameZh               String     @map("name_zh") @db.VarChar(200)
  nameEn               String?    @map("name_en") @db.VarChar(200)
  rank                 Int?
  schoolType           SchoolType @map("school_type")
  citySlug             String?    @map("city_slug") @db.VarChar(120)
  cityZh               String?    @map("city_zh") @db.VarChar(120)
  guaranteedAdmission  Boolean    @default(false) @map("guaranteed_admission")
  tierEn               String?    @map("tier_en")
  region               String?
  logoUrl              String?    @map("logo_url")
  officialWebsite      String?    @map("official_website")
  applicationSystemUrl String?    @map("application_system_url")

  admissionLevel          Json?   @map("admission_level")
  hskRequirement          String? @map("hsk_requirement") @db.Text
  hskNotes                String? @map("hsk_notes") @db.Text
  cscaRequirement         String? @map("csca_requirement") @db.Text
  cscaRequired            Boolean @default(false) @map("csca_required")
  cscaRequirementNote     String? @map("csca_requirement_note") @db.Text
  undergradRequirements   String? @map("undergrad_requirements") @db.Text
  postgradRequirements    String? @map("postgrad_requirements") @db.Text
  preparatoryRequirements String? @map("preparatory_requirements") @db.Text
  languageOfInstruction   Json?   @map("language_of_instruction")

  hskMinLevel            Int?    @map("hsk_min_level")
  hskChineseMinLevel     Int?    @map("hsk_chinese_min_level")
  hskChineseMinListening Int?    @map("hsk_chinese_min_listening")
  hskChineseMinReading   Int?    @map("hsk_chinese_min_reading")
  hskChineseMinWriting   Int?    @map("hsk_chinese_min_writing")
  hskChineseConditional  String? @map("hsk_chinese_conditional") @db.Text
  hskEnglishRequired     Boolean @default(false) @map("hsk_english_required")
  hskkRequired           Boolean @default(false) @map("hskk_required")
  hskkChineseMinLevel    String? @map("hskk_chinese_min_level")
  hskkChineseConditional String? @map("hskk_chinese_conditional") @db.Text
  englishRequired        Boolean @default(false) @map("english_required")
  englishMinIelts        Float?  @map("english_min_ielts")
  englishMinToefl        Int?    @map("english_min_toefl")
  englishRequirementNote String? @map("english_requirement_note") @db.Text

  round1Deadline   String? @map("round1_deadline")
  round2Deadline   String? @map("round2_deadline")
  round1OpenDate   String? @map("round1_open_date")
  round1CloseDate  String? @map("round1_close_date")
  round2OpenDate   String? @map("round2_open_date")
  round2CloseDate  String? @map("round2_close_date")
  applicationSteps String? @map("application_steps") @db.Text

  tuitionSummary    String? @map("tuition_summary") @db.Text
  tuitionByCategory Json?   @map("tuition_by_category")
  applicationFee    String? @map("application_fee")
  insurance         String?
  accommodationCost String? @map("accommodation_cost")
  accommodationType String? @map("accommodation_type")
  scholarships      Json?

  englishPrograms  String? @map("english_programs") @db.Text
  notablePrograms  String? @map("notable_programs") @db.Text
  campusFacilities String? @map("campus_facilities") @db.Text
  programFields    String? @map("program_fields") @db.Text
  contactTel       String? @map("contact_tel")
  contactEmail     String? @map("contact_email")
  contactAddress   String? @map("contact_address") @db.Text
  yearEstablished  Int?    @map("year_established")
  studentCount     String? @map("student_count")
  studentsServed   Int?    @map("students_served")

  under18GuardianRequired Boolean      @default(false) @map("under_18_guardian_required")
  under18RequirementNote  String?      @map("under_18_requirement_note") @db.Text
  status                  SchoolStatus @default(draft)
  version                 Int          @default(1)
  source                  String?
  sourceId                String?      @map("source_id")
  sourceUrl               String?      @map("source_url")
  dataQualityScore        Int?         @map("data_quality_score")
  lastVerifiedAt          DateTime?    @map("last_verified_at")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  changeLogs           SchoolChangeLog[]
  snapshots            SchoolSnapshot[]
  programs             SchoolProgram[]
  cscaRules            SchoolCscaRule[]
  detailedScholarships SchoolScholarship[]
  scholarshipLinks     ScholarshipSchool[]
  savedByUsers         SavedSchool[]
  compareByUsers       SchoolCompareItem[]
  cartItems            CartItem[]
  orderItems           OrderItem[]

  @@index([status, rank], map: "idx_schools_status_rank")
  @@index([status, citySlug, rank], map: "idx_schools_status_city_rank")
  @@index([schoolType, region], map: "idx_schools_type_region")
  @@index([cscaRequired, hskMinLevel], map: "idx_schools_csca_hsk")
  @@index([round1Deadline, round2Deadline], map: "idx_schools_deadline")
  @@index([nameZh], map: "idx_schools_name_zh")
  @@index([nameEn], map: "idx_schools_name_en")
  @@map("schools")
}

model SchoolProgram {
  id                 Int          @id @default(autoincrement())
  schoolId           Int          @map("school_id")
  nameZh             String       @map("name_zh") @db.VarChar(240)
  nameEn             String?      @map("name_en") @db.VarChar(240)
  degreeLevel        String?      @map("degree_level") @db.VarChar(80)
  durationYears      String?      @map("duration_years") @db.VarChar(80)
  fieldCategory      String?      @map("field_category") @db.VarChar(160)
  teachingLanguage   String?      @map("teaching_language") @db.VarChar(120)
  cscaSubjects       Json?        @map("csca_subjects")
  cscaRequirement    String?      @map("csca_requirement") @db.Text
  hskRequirement     String?      @map("hsk_requirement") @db.Text
  englishRequirement String?      @map("english_requirement") @db.Text
  tuitionAmount      Int?         @map("tuition_amount")
  tuitionCurrency    String?      @map("tuition_currency") @db.VarChar(12)
  tuitionPeriod      String?      @map("tuition_period") @db.VarChar(80)
  tuitionText        String?      @map("tuition_text") @db.Text
  scholarshipText    String?      @map("scholarship_text") @db.Text
  openDate           DateTime?    @map("open_date")
  deadlineDate       DateTime?    @map("deadline_date")
  deadlineLabel      String?      @map("deadline_label") @db.VarChar(160)
  applicationRound   String?      @map("application_round") @db.VarChar(120)
  applicationUrl     String?      @map("application_url") @db.Text
  applicationNote    String?      @map("application_note") @db.Text
  sourceUrl          String?      @map("source_url") @db.Text
  sourceLabel        String?      @map("source_label") @db.VarChar(240)
  lastVerifiedAt     DateTime?    @map("last_verified_at")
  sortOrder          Int          @default(0) @map("sort_order")
  status             SchoolStatus @default(draft)
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  school           School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cscaRules        SchoolCscaRule[]
  scholarships     SchoolScholarship[]
  scholarshipLinks ScholarshipProgram[]

  @@index([schoolId], map: "idx_school_programs_school")
  @@index([schoolId, status, sortOrder], map: "idx_school_programs_school_status_sort")
  @@index([degreeLevel, teachingLanguage], map: "idx_school_programs_degree_language")
  @@index([deadlineDate, status], map: "idx_school_programs_deadline_status")
  @@index([status, updatedAt], map: "idx_school_programs_status_updated")
  @@map("school_programs")
}

model SchoolCscaRule {
  id                Int          @id @default(autoincrement())
  schoolId          Int          @map("school_id")
  programId         Int?         @map("program_id")
  title             String       @db.VarChar(240)
  category          String       @db.VarChar(80)
  scope             String?      @db.VarChar(240)
  cscaSubjects      Json?        @map("csca_subjects")
  languageCondition String?      @map("language_condition") @db.Text
  description       String?      @db.Text
  importantNote     String?      @map("important_note") @db.Text
  sourceUrl         String?      @map("source_url") @db.Text
  sourceLabel       String?      @map("source_label") @db.VarChar(240)
  lastVerifiedAt    DateTime?    @map("last_verified_at")
  sortOrder         Int          @default(0) @map("sort_order")
  status            SchoolStatus @default(draft)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program SchoolProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, sortOrder], map: "idx_school_csca_rules_school_status_sort")
  @@index([programId], map: "idx_school_csca_rules_program")
  @@index([category, status], map: "idx_school_csca_rules_category_status")
  @@map("school_csca_rules")
}

model SchoolScholarship {
  id                Int          @id @default(autoincrement())
  schoolId          Int          @map("school_id")
  programId         Int?         @map("program_id")
  name              String       @db.VarChar(240)
  type              String       @default("general") @db.VarChar(80)
  coverage          String?      @db.Text
  applicableDegree  String?      @map("applicable_degree") @db.VarChar(160)
  applicableProgram String?      @map("applicable_program") @db.VarChar(240)
  amountText        String?      @map("amount_text") @db.Text
  requirementText   String?      @map("requirement_text") @db.Text
  sourceUrl         String?      @map("source_url") @db.Text
  sourceLabel       String?      @map("source_label") @db.VarChar(240)
  lastVerifiedAt    DateTime?    @map("last_verified_at")
  sortOrder         Int          @default(0) @map("sort_order")
  status            SchoolStatus @default(draft)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program SchoolProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, sortOrder], map: "idx_school_scholarships_school_status_sort")
  @@index([programId], map: "idx_school_scholarships_program")
  @@index([type, status], map: "idx_school_scholarships_type_status")
  @@map("school_scholarships")
}

model Scholarship {
  id                   Int          @id @default(autoincrement())
  slug                 String       @unique @db.VarChar(260)
  title                String       @db.VarChar(240)
  type                 String       @default("other") @db.VarChar(80)
  fundingLevel         String       @default("unknown") @map("funding_level") @db.VarChar(40)
  providerName         String?      @map("provider_name") @db.VarChar(180)
  providerNameEn       String?      @map("provider_name_en") @db.VarChar(180)
  providerLocation     String?      @map("provider_location") @db.VarChar(180)
  summary              String?      @db.Text
  coverage             String?      @db.Text
  applicableDegree     String?      @map("applicable_degree") @db.VarChar(160)
  applicableProgram    String?      @map("applicable_program") @db.VarChar(240)
  amountText           String?      @map("amount_text") @db.Text
  requirementText      String?      @map("requirement_text") @db.Text
  bodySections         Json?        @map("body_sections")
  benefitItems         Json?        @map("benefit_items")
  eligibilityItems     Json?        @map("eligibility_items")
  applicationMaterials Json?        @map("application_materials")
  applicationSteps     Json?        @map("application_steps")
  contactInfo          Json?        @map("contact_info")
  actionLinks          Json?        @map("action_links")
  deadlineDate         DateTime?    @map("deadline_date")
  deadlineLabel        String?      @map("deadline_label") @db.VarChar(160)
  applicationRound     String?      @map("application_round") @db.VarChar(120)
  targetCountries      Json?        @map("target_countries")
