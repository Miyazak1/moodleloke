  sourceTitle        String    @map("source_title") @db.VarChar(240)
  sourceUrl          String?   @map("source_url") @db.VarChar(1000)
  sourcePublishedAt  DateTime? @map("source_published_at") @db.Date
  sourceSnapshotHash String    @map("source_snapshot_hash") @db.VarChar(128)
  scoreScale         Json      @map("score_scale")
