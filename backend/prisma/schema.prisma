// Real examination results are optional, consented evidence. Scores are immutable:
// a correction creates a replacement and supersedes the previous record.
model StudentExamOutcome {
  id                   String    @id @default(cuid())
  userId               Int       @map("user_id")
  examSystemCode       String    @default("csca") @map("exam_system_code") @db.VarChar(40)
  subjectCode          String    @map("subject_code") @db.VarChar(24)
  examDate             DateTime  @map("exam_date") @db.Date
  examFormCode         String?   @map("exam_form_code") @db.VarChar(80)
  score                Float
  scoringPolicyVersion String    @map("scoring_policy_version") @db.VarChar(80)
  status               String    @default("submitted") @db.VarChar(24)
  consentPurpose       String    @map("consent_purpose") @db.VarChar(80)
  consentVersion       String    @map("consent_version") @db.VarChar(40)
  consentedAt          DateTime  @map("consented_at")
  consentWithdrawnAt   DateTime? @map("consent_withdrawn_at")
  reviewedByUserId     Int?      @map("reviewed_by_user_id")
  reviewedAt           DateTime? @map("reviewed_at")
  verifiedByUserId     Int?      @map("verified_by_user_id")
  verifiedAt           DateTime? @map("verified_at")
  replacesOutcomeId    String?   @map("replaces_outcome_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user            User                            @relation("StudentExamOutcomeOwner", fields: [userId], references: [id], onDelete: Cascade)
  scoringPolicy   ExamScoringPolicy               @relation(fields: [scoringPolicyVersion], references: [policyVersion], onDelete: Restrict)
  reviewedBy      User?                           @relation("StudentExamOutcomeReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  verifiedBy      User?                           @relation("StudentExamOutcomeVerifier", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  replaces        StudentExamOutcome?             @relation("StudentExamOutcomeCorrections", fields: [replacesOutcomeId], references: [id], onDelete: Restrict)
  corrections     StudentExamOutcome[]            @relation("StudentExamOutcomeCorrections")
  evidence        StudentExamOutcomeEvidence[]
  events          StudentExamOutcomeEvent[]
  calibrationRows ForecastCalibrationDatasetRow[]

  @@index([userId, createdAt], map: "idx_student_exam_outcomes_user_created")
  @@index([status, subjectCode, examDate], map: "idx_student_exam_outcomes_status_subject_exam")
  @@index([scoringPolicyVersion, status], map: "idx_student_exam_outcomes_policy_status")
  @@index([replacesOutcomeId], map: "idx_student_exam_outcomes_replaces")
  @@map("student_exam_outcomes")
}

