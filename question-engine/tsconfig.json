{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "core",
    "outDir": "dist/core",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["core/**/*.ts"],
  "exclude": ["dist", "test"]
}
